# ===== הגדרות בוט AI — העתק ל-.env :  cp .env.example .env =====
# חובה: כלום! הבוט עובד גם בלי מפתחות בכלל (Pollinations חינמי + yt-search חינמי).
# מומלץ: להוסיף לפחות מפתח חינמי אחד לצ'אט מהיר ואיכותי.

# --- צ'אט AI (נבחר אוטומטית: OpenAI → Groq → Gemini → Pollinations) ---
# 1. OpenAI — הכי איכותי, בתשלום: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 2. Groq — חינמי ומהיר מאוד (מומלץ!): https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# 💻 מודל לפיתוח/קוד (אתרים) — החזק ביותר הזמין בחינמי בחשבון (נבדק: openai/gpt-oss-120b)
GROQ_CODE_MODEL=openai/gpt-oss-120b
# 3. Gemini — חינמי של גוגל: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# 🌙 תמונות Nano Banana (חינמי, אותו מפתח!): https://aistudio.google.com/app/apikey
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# ☁️ Cloudflare FLUX — חינמי יומי, בלי כרטיס: https://dash.cloudflare.com
# (Workers AI ← Use REST API ← Create token + Account ID מהדשבורד)
CF_ACCOUNT_ID=
CF_API_TOKEN=
# 🔌 SiliconFlow — קרדיטים חינמיים בהרשמה: https://cloud.siliconflow.com
SILICONFLOW_API_KEY=
# 4. Pollinations — חינמי לגמרי, בלי מפתח (fallback תמידי)
POLLINATIONS_TEXT_MODEL=openai
POLLINATIONS_IMAGE_MODEL=flux
# --- 🖼️ גלריה: דחיפת תוצרים מהבוטים לאתר החי ---
# יוצרים מחרוזת אקראית (למשל: openssl rand -hex 32), שמים כאן
# ובדיוק אותה מחרוזת ב-Render Dashboard ← Environment ← GALLERY_SECRET
GALLERY_SECRET=
GALLERY_SERVER_URL=https://multibot-zuk0.onrender.com
# --- מוזיקה חינמית (!מנגינה / !הלחן) — טוקן חינמי, בלי כרטיס ---
# 1. נרשמים חינם: https://huggingface.co/join
# 2. יוצרים טוקן: https://huggingface.co/settings/tokens (New token)
# 3. מדביקים כאן:
HF_TOKEN=
# גיבוי אופציונלי: מפתח Pollinations — https://enter.pollinations.ai
POLLINATIONS_API_KEY=

# --- 🎵 Suno MCP — יצירת שירים/מנגינות אמיתיות (OAuth, בלי מפתח API) ---
# אחרי שמירת הקובץ מריצים פעם אחת: npm run suno-login
# ופותחים בדפדפן את הקישור שנוצר. הטוקן נשמר ב-suno-auth.json (לא ב-git).
# כתובת ה-MCP הרשמית (אין צורך לשנות):
SUNO_MCP_URL=https://api.suno.com/mcp
# אופציונלי: Bearer ידני במקום OAuth (אם יש לך טוקן מוכן)
SUNO_MCP_TOKEN=
# מגבלת שירים ליום לכל משתמש (0 = ללא הגבלה)
SUNO_DAILY_PER_USER=0
# זמן המתנה מקסימלי ליצירת שיר במילישניות (ברירת מחדל 8 דקות)
SUNO_TIMEOUT_MS=480000
# דריסה ידנית של בחירת כלי MCP (בדרך כלל לא צריך):
# SUNO_GENERATE_TOOL=
# SUNO_WAIT_TOOL=
# SUNO_MODEL=

# --- YouTube לשירים/סרטונים (אופציונלי — בלי זה עובד עם yt-search חינמי) ---
# מפתח רשמי: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# --- TMDB לספריית סרטים אישית (אופציונלי, חינמי) ---
# מפתח חינמי מ- https://www.themoviedb.org/settings/api
TMDB_API_KEY=PUT_YOUR_TMDB_KEY_HERE
TMDB_LANG=he-IL

# --- בוטי תמונות חיצוניים (Instinct) ---
# כל המספרים המוכרים (גם כבויים — הבוט לא יענה להם). מופרדים בפסיקים.
INSTINCT_JIDS=16508702892@s.whatsapp.net,12512765320@s.whatsapp.net
# רק המספרים האלה יקבלו בקשות ליצירת תמונות (ברירת מחדל: הראשון בלבד).
# כדי להפעיל גם את השני: INSTINCT_ACTIVE_JIDS=16508702892@s.whatsapp.net,12512765320@s.whatsapp.net
INSTINCT_ACTIVE_JIDS=16508702892@s.whatsapp.net

# --- בוט יצירת סרטונים דרך וואטסאפ ---
# כבוי כברירת מחדל. להפעלה: true
VIDEO_ENABLED=false
# הראשי (251) והגיבוי (650). ריק ב-VIDEO_FALLBACK_JID = בלי גיבוי.
VIDEO_JID=12512765320@s.whatsapp.net
VIDEO_FALLBACK_JID=16508702892@s.whatsapp.net
# כמה זמן להמתין לסרטון מכל בוט (מילישניות) — 100 דקות
VIDEO_TIMEOUT_MS=6000000
# ניסיון אחד לכל משתמש ביום + ניסיון אחד לכל בוט ביום (הבעלים 0555655217 פטור מהמגבלות)
VIDEO_DAILY_PER_USER=1
VIDEO_DAILY_PER_BOT=1

# --- התנהגות ---
# קידומת בקבוצות (בפרטי אפשר גם בלי)
BOT_PREFIX=!
# שם הבוט בתפריט
BOT_NAME=בוט AI 🤖
# הגבלת קבוצות: רשימת JID-ים בפסיקים. ריק = כל הקבוצות מורשות.
# מגלים JID עם הפקודה !id בתוך הקבוצה.
# --- WhatsApp רשמי (Cloud API) - שרת waba-server.js ---
# חינם להפעלה, תשלום ל-Meta לפי הודעה (ראה הסבר למטה)
WABA_TOKEN=
WABA_PHONE_NUMBER_ID=
WABA_VERIFY_TOKEN=clinic123
PORT=3000
CLINIC_NAME=המרפאה
CLINIC_INFO=שעות: א-ה 8:00-19:00. כתובת: ... טלפון: ...
ALLOWED_GROUPS=

# 💼 קבוצת עבודות + פרסום אוטומטי (09:00 / 19:00)
JOBS_GROUP=
JOBS_AUTO=true
JOBS_CHECK_MINUTES=30
JOBS_MAX_PER_CHECK=3
JOBS_ACTIVE_HOURS=8-23
