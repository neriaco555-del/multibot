# ===== הגדרות בוט AI — העתק ל-.env :  cp .env.example .env =====
# חובה: כלום! הבוט עובד גם בלי מפתחות בכלל (Pollinations חינמי + yt-search חינמי).
# מומלץ: להוסיף לפחות מפתח חינמי אחד לצ'אט מהיר ואיכותי.

# --- צ'אט AI (נבחר אוטומטית: OpenAI → Groq → Gemini → Pollinations) ---
# 1. OpenAI — הכי איכותי, בתשלום: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 2. Groq — חינמי ומהיר מאוד (מומלץ!): https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# 💻 מודל לפיתוח/קוד (אתרים) — החזק ביותר הזמין בחינמי בחשבון (נבדק: openai/gpt-oss-120b)
GROQ_CODE_MODEL=openai/gpt-oss-120b
# 3. Gemini — חינמי של גוגל: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# 🌙 תמונות Nano Banana (חינמי, אותו מפתח!): https://aistudio.google.com/app/apikey
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# ☁️ Cloudflare FLUX — חינמי יומי, בלי כרטיס: https://dash.cloudflare.com
# (Workers AI ← Use REST API ← Create token + Account ID מהדשבורד)
CF_ACCOUNT_ID=
CF_API_TOKEN=
# 🔌 SiliconFlow — קרדיטים חינמיים בהרשמה: https://cloud.siliconflow.com
SILICONFLOW_API_KEY=
# 4. Pollinations — חינמי לגמרי, בלי מפתח (fallback תמידי)
POLLINATIONS_TEXT_MODEL=openai
POLLINATIONS_IMAGE_MODEL=flux
# --- מוזיקה חינמית (!מנגינה / !הלחן) — טוקן חינמי, בלי כרטיס ---
# 1. נרשמים חינם: https://huggingface.co/join
# 2. יוצרים טוקן: https://huggingface.co/settings/tokens (New token)
# 3. מדביקים כאן:
HF_TOKEN=
# גיבוי אופציונלי: מפתח Pollinations — https://enter.pollinations.ai
POLLINATIONS_API_KEY=

# --- YouTube לשירים/סרטונים (אופציונלי — בלי זה עובד עם yt-search חינמי) ---
# מפתח רשמי: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# --- TMDB לספריית סרטים אישית (אופציונלי, חינמי) ---
# מפתח חינמי מ- https://www.themoviedb.org/settings/api
TMDB_API_KEY=PUT_YOUR_TMDB_KEY_HERE
TMDB_LANG=he-IL

# --- התנהגות ---
# קידומת בקבוצות (בפרטי אפשר גם בלי)
BOT_PREFIX=!
# שם הבוט בתפריט
BOT_NAME=בוט AI 🤖
# הגבלת קבוצות: רשימת JID-ים בפסיקים. ריק = כל הקבוצות מורשות.
# מגלים JID עם הפקודה !id בתוך הקבוצה.
# --- WhatsApp רשמי (Cloud API) - שרת waba-server.js ---
# חינם להפעלה, תשלום ל-Meta לפי הודעה (ראה הסבר למטה)
WABA_TOKEN=
WABA_PHONE_NUMBER_ID=
WABA_VERIFY_TOKEN=clinic123
PORT=3000
CLINIC_NAME=המרפאה
CLINIC_INFO=שעות: א-ה 8:00-19:00. כתובת: ... טלפון: ...
ALLOWED_GROUPS=
